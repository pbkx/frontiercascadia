# Local pretrained Fishial YOLO fish detector (no training or API key)
DETECTOR_BACKEND=fishial
FISHIAL_MODEL_PATH=models/fishial.pt
INFERENCE_DEVICE=auto
# Optional compatible fish-specific local YOLO weights
LOCAL_MODEL_PATH=
# Sources, resolved relative to project root
DEFAULT_STREAM_URL=https://www.youtube.com/watch?v=tWFigWkp98o
DEFAULT_DEMO_VIDEO_PATH=data/demo/salmon_demo.mp4
DEMO_DETECTIONS_PATH=data/demo/detections.json
# CV
CONFIDENCE_THRESHOLD=0.35
INFERENCE_SAMPLE_FPS=10
STREAM_RECONNECT_ATTEMPTS=8
PASSAGE_RATE_MIN_SECONDS=300
REVERSAL_THRESHOLD=0.025
DWELL_THRESHOLD_SECONDS=8
TRACK_HISTORY_LENGTH=600
# Services
BACKEND_PORT=8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
